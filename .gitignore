# VS Code
.vscode/

# WorkBuddy workspace files
.workbuddy/

# macOS system files
.DS_Store

# Python cache
__pycache__/
*.pyc

# Reference / inspiration images (local only)
inspo/

# Local video re-encode backups (not for repo)
assets/videos/*.bak

# Image re-encode originals (kept locally for rollback, not for repo)
assets/.bak-originals/

# Test fixtures: A/B variants and falsification probes live under pages/__*.html.
# They are generated by scripts in ~/.workbuddy/scratch/ and must never be committed.
pages/__*.html

# 相簿文件夹（assets/photos/）：仓库里只留 manifest.json / manifest.csv。
# 图片一张都不进 —— 站点读 R2（https://pub-4a7ebf0d83dc43fe81c6d3a51b017cfc.r2.dev/images/photos/…），
# 地址写在 assets/js/photos.js 的 CDN / CDN_V 两行（与动态页那 58 张同一套做法）。
#
# 本地完整生命周期（2026-09-23 主人「我只要保留 webp」定下）：
#   1. 原图放 assets/photos/<slug>/<时间戳>.heic（临时，编完就删）
#   2. python3 tools/photos-derive.py        产出 536 个 webp（view 1440 + _thumbs 900，81 MB）
#   3. bash tools/photos-sync.sh             同步到 R2
#   4. 删原图（源片在 ~/Downloads/Photo + ~/Downloads/PolyU，
#      要捞回来用 python3 tools/photos-originals.py --restore）
# 下面几条是「万一又导入了」的护栏，别删 —— 原图/webp 任何一份进 git 都会把仓库拖垮。
assets/photos/**/*.heic
assets/photos/**/*.HEIC
assets/photos/**/*.jpg
assets/photos/**/*.JPG
assets/photos/**/*.webp

# 去重时移出来的近似照 + 一次性分类核对页（历史产物，本地看过就扔，别再提交）
assets/photos/_duplicates/
assets/photos/_review/
